{
  "name": "lawndisorder-client",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "module": "index.js",
  "type": "module",
  "scripts": {
    "clean": "rm tsconfig.tsbuildinfo; rm -rf ./out; rm -rf ./out-tsc",
    "start": "npm run dev",
    "dev": "echo need to npm run dev-ts, dev-js, dev-css and finally dev-serve",
    "dev-ts": "tsc --build --watch",
    "dev-js": "npm run esbuild-configured -- --watch=\"forever\" --define:import.meta.env.WSS_SERVER=\\\"\\\"",
    "dev-css": "npx @tailwindcss/cli -i ./src/input.css -o ./out/output.css --watch",
    "dev-serve": "npx serve -s -l 8092 --no-port-switching out",
    "build": "npm run build-css; npm run build-ts; npm run build-js",
    "build-ts": "tsc --build",
    "build-js": "npm run esbuild-configured -- --minify --define:process.env.NODE_ENV=\\\"production\\\" --define:import.meta.env.WSS_SERVER=\\\"$WSS_SERVER\\\"",
    "build-css": "npx @tailwindcss/cli -i ./src/input.css -o ./out/output.css",
    "build-static-files": "cp src/*.html out/; cp src/*.ico out/; cp src/*.png out/",
    "esbuild-configured": "npx esbuild out-tsc/index.js --asset-names=[name] --public-path=/ --loader:.html=file --loader:.png=file --loader:.txt=file --bundle --outdir=out",
    "lint": "eslint ."
  },
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "history": "^5.3.0",
    "immer": "^11.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.6.2",
    "serve": "^14.2.5",
    "tailwindcss": "^4.1.17",
    "typescript": "^7.0.2"
  }
}
