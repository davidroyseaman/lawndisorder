{
  "name": "lawndisorder-server",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "rm tsconfig.tsbuildinfo; rm -rf ./out; rm -rf ./out-tsc",
    "build-ts": "tsc --build",
    "build-js": "npm run esbuild-configured -- --minify --define:process.env.NODE_ENV=\\\"production\\\"",
    "esbuild-configured": "npx esbuild out-tsc/index.js --platform=node --asset-names=[name] --public-path=/ --bundle --outdir=out --packages=bundle",
    "dev": "tsc --build --watch",
    "start": "node ./out-tsc/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.25.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
